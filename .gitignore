# ---------------------------------------------------------------------------
# Secrets: never commit these. Only the *.example files are published.
# ---------------------------------------------------------------------------
# Real database credentials (template: backend/config/db.local.example.php)
backend/config/db.local.php

# Environment files (template: .env.example)
.env
.env.*
!.env.example

# Android signing keys and machine-specific SDK paths
*.jks
*.keystore
key.properties
local.properties

# DuckDNS update scripts contain your DuckDNS token
duck.bat
duck.sh

# FTP/SFTP client exports (FileZilla, WinSCP)
*.xml.filezilla
FileZilla*.xml
WinSCP*.ini

