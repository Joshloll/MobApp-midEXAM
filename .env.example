# Copy this file to .env and fill in your own values.
# .env is git-ignored. PHP does not load .env files by itself: these names are
# read by backend/config/db.php with getenv(), so set them as environment
# variables on your server. The simpler option is to copy
# backend/config/db.local.example.php to db.local.php instead.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dry_goods_db
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_CHARSET=utf8mb4
